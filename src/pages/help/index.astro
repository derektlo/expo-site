---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const articles = await getCollection('help');

// Display order for categories; any category not listed falls to the end.
const CATEGORY_ORDER = [
  'Getting Started',
  'Importing Recipes',
  'AI Recipes & Personalization',
  'Cooking',
  'Planning & Shopping',
  'Sharing & Social',
  'Account & Settings',
  'Troubleshooting',
];

const byCategory = new Map<string, typeof articles>();
for (const article of articles) {
  const list = byCategory.get(article.data.category) ?? [];
  list.push(article);
  byCategory.set(article.data.category, list);
}
const categories = [...byCategory.keys()].sort((a, b) => {
  const ai = CATEGORY_ORDER.indexOf(a);
  const bi = CATEGORY_ORDER.indexOf(b);
  return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
});
for (const list of byCategory.values()) {
  list.sort((a, b) => (a.data.order - b.data.order) || a.data.title.localeCompare(b.data.title));
}
---

<Layout title="Expo Help Center" description="Guides and answers for importing, generating, cooking, planning, and sharing recipes with Expo.">
  <nav class="hc-nav">
    <div class="hc-nav-inner">
      <a href="/" class="hc-logo" aria-label="Expo home">
        <img src="/expo-logo.svg" alt="Expo" width="110" height="30" />
      </a>
      <a href="/" class="hc-nav-link">Back to home</a>
    </div>
  </nav>

  <header class="hc-hero">
    <h1>How can we help?</h1>
    <p>Browse guides below, or ask the assistant in the corner anything about Expo.</p>
    <div class="hc-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input id="hc-search-input" type="text" placeholder="Search the help center…" aria-label="Search the help center" autocomplete="off" />
    </div>
    <button id="hc-ask" class="hc-ask">Ask the assistant instead →</button>
  </header>

  <main class="hc-main">
    <p id="hc-no-results" class="hc-no-results" hidden>No articles match your search. Try the assistant in the corner.</p>
    {categories.map((category) => (
      <section class="hc-category" data-category>
        <h2>{category}</h2>
        <div class="hc-grid">
          {byCategory.get(category)!.map((article) => (
            <a class="hc-card" href={`/help/${article.slug}`} data-text={`${article.data.title} ${article.data.description} ${category}`.toLowerCase()}>
              <span class="hc-card-title">{article.data.title}</span>
              <span class="hc-card-desc">{article.data.description}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>

  <footer class="hc-footer">
    <p>Still need help? Email <a href="mailto:support@heyexpo.com">support@heyexpo.com</a>.</p>
  </footer>
</Layout>

<script>
  const input = document.getElementById('hc-search-input') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.hc-card'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));
  const noResults = document.getElementById('hc-no-results');
  const askBtn = document.getElementById('hc-ask');

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const match = !q || (card.dataset.text ?? '').includes(q);
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    }
    // Hide category sections with no visible cards.
    for (const section of sections) {
      const anyVisible = section.querySelector<HTMLElement>('.hc-card:not([style*="display: none"])');
      section.style.display = anyVisible ? '' : 'none';
    }
    if (noResults) noResults.hidden = visible !== 0;
  });

  askBtn?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('open-support-chat')));
</script>

<style>
  .hc-nav { background: var(--deep-green); }
  .hc-nav-inner { max-width: 900px; margin: 0 auto; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; }
  .hc-logo img { height: 28px; width: auto; }
  .hc-nav-link { color: rgba(208,255,194,0.75); font-size: 14px; font-weight: 500; }
  .hc-nav-link:hover { color: var(--green); }

  .hc-hero { background: var(--deep-green); color: var(--green); text-align: center; padding: 40px 24px 64px; }
  .hc-hero h1 { font-family: 'Fraunces', serif; font-weight: 400; font-size: clamp(32px, 5vw, 52px); letter-spacing: -0.02em; margin-bottom: 14px; }
  .hc-hero p { color: rgba(208,255,194,0.7); font-size: 17px; margin-bottom: 32px; }

  .hc-search { max-width: 520px; margin: 0 auto; position: relative; display: flex; align-items: center; }
  .hc-search svg { position: absolute; left: 18px; width: 20px; height: 20px; color: #9aa; pointer-events: none; }
  .hc-search input { width: 100%; border: none; border-radius: 100px; padding: 16px 20px 16px 48px; font-size: 16px; font-family: inherit; outline: none; box-shadow: 0 8px 30px rgba(0,0,0,0.18); }

  .hc-ask { margin-top: 18px; background: transparent; border: none; color: var(--green); font-size: 14px; font-weight: 500; cursor: pointer; opacity: 0.85; }
  .hc-ask:hover { opacity: 1; text-decoration: underline; }

  .hc-main { max-width: 900px; margin: 0 auto; padding: 56px 24px; }
  .hc-no-results { text-align: center; color: var(--text-mid); font-size: 16px; padding: 40px 0; }

  .hc-category { margin-bottom: 44px; }
  .hc-category h2 { font-family: 'Fraunces', serif; font-weight: 400; font-size: 26px; color: var(--deep-green); margin-bottom: 18px; letter-spacing: -0.01em; }

  .hc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .hc-card { display: flex; flex-direction: column; gap: 6px; background: #fff; border: 1px solid rgba(8,65,33,0.1); border-radius: 16px; padding: 18px 20px; transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease; }
  .hc-card:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(8,65,33,0.1); border-color: rgba(8,65,33,0.2); }
  .hc-card-title { font-size: 16px; font-weight: 600; color: var(--deep-green); }
  .hc-card-desc { font-size: 14px; line-height: 1.5; color: var(--text-mid); }

  .hc-footer { text-align: center; padding: 40px 24px 64px; color: var(--text-mid); font-size: 15px; background: #fff; }
  .hc-footer a { color: var(--orange); text-decoration: underline; }

  body { background: #fff; }
</style>

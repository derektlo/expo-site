<style>
  /* ===== DECORATIVE ILLUSTRATIONS ===== */
  .deco-illus {
    position: absolute;
    pointer-events: none;
    user-select: none;
  }

  .hero-sparkles {
    right: 48px;
    bottom: 80px;
    width: 120px;
    opacity: 0.25;
    filter: brightness(0) invert(1);
  }

  /* ===== NAV ===== */
  .nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    color: var(--green);
  }


  /* ===== HERO ===== */
  .hero {
    background: var(--deep-green);
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    padding-top: 20px;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -200px;
    right: -200px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(208,255,194,0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 32px;
    display: flex;
    align-items: center;
    gap: 80px;
    width: 100%;
  }

  .hero-content {
    flex: 1;
    min-width: 0;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    background: rgba(208, 255, 194, 0.1);
    border: 1px solid rgba(208, 255, 194, 0.2);
    border-radius: 100px;
    color: var(--green);
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 28px;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    background: #4ade80;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.25);
  }

  .hero-heading {
    font-family: 'Fraunces', serif;
    font-size: clamp(38px, 5.5vw, 72px);
    font-weight: 400;

    line-height: 1.08;
    color: var(--green);
    margin-bottom: 24px;
    letter-spacing: -0.025em;
    max-width: 560px;
  }

  .hero-sub {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: rgba(208, 255, 194, 0.65);
    margin-bottom: 44px;
    max-width: 460px;
  }

  .hero-visual {
    flex: 0 0 auto;
    display: flex;
    justify-content: center;
  }

  /* ===== PHONE FRAME ===== */
  .phone-frame {
    width: 260px;
    height: 540px;
    background: #1c1c1e;
    border-radius: 46px;
    padding: 13px;
    box-shadow:
      0 70px 140px rgba(0, 0, 0, 0.5),
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.1);
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
  }

  .phone-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 34px;
  }

  .phone-light {
    background: #e8e8ed;
    box-shadow:
      0 70px 140px rgba(0, 0, 0, 0.2),
      inset 0 0 0 1.5px rgba(0, 0, 0, 0.1);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 20px;
    background: var(--green);
    color: var(--deep-green);
    border-radius: 100px;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s, transform 0.2s;
  }

  .nav-cta:hover {
    background: #ffffff;
    transform: translateY(-1px);
  }

  /* ===== APP STORE BADGE ===== */
  .appstore-badge-link {
    display: inline-block;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .appstore-badge-link:hover {
    transform: translateY(-2px);
    opacity: 0.85;
  }

  .appstore-badge-img {
    height: 54px;
    width: auto;
    display: block;
  }

  /* ===== FEATURES ===== */
  .feature {
    padding: 120px 32px;
    min-height: 780px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .feature-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  .feature-inner.reverse {
    flex-direction: row-reverse;
  }

  .feature-text {
    flex: 1;
    min-width: 0;
  }

  .feature-phone {
    flex: 0 0 auto;
  }

  .feature-visual {
    flex: 1;
    min-width: 0;
  }

  .feat-cream { background: var(--cream); }
  .feat-dark  { background: var(--deep-green); }
  .feat-green { background: var(--green); }
  .feat-white { background: #ffffff; }
  .feat-amber { background: var(--amber); }

  .feat-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .feat-heading {
    font-family: 'Fraunces', serif;
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 400;

    line-height: 1.12;
    color: var(--deep-green);
    margin-bottom: 16px;
    letter-spacing: -0.015em;
  }

  .feat-body {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-mid);
    margin-bottom: 28px;
  }

  .feat-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .feat-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--deep-green);
  }

  .feat-list li::before {
    content: '✓';
    width: 22px;
    height: 22px;
    min-width: 22px;
    background: var(--check-bg, var(--deep-green));
    color: var(--check-text, var(--green));
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
  }

  .feat-list-light li {
    color: rgba(208, 255, 194, 0.85);
  }

  .feat-list-light li::before {
    background: rgba(208, 255, 194, 0.2);
    color: var(--green);
  }

  /* ===== SHARE ILLUSTRATION ===== */
  .share-illustration {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .share-card {
    background: white;
    border-radius: 20px;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 8px 40px rgba(8, 65, 33, 0.12);
  }

  .share-card-sm {
    transform: scale(0.95);
    opacity: 0.8;
    margin-left: 24px;
  }

  .share-emoji {
    font-size: 36px;
    width: 60px;
    height: 60px;
    background: var(--cream);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .share-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .share-info strong {
    font-size: 15px;
    font-weight: 700;
    color: var(--deep-green);
  }

  .share-info span {
    font-size: 13px;
    color: #888;
  }

  .star-row {
    display: flex;
    gap: 1px;
    margin-top: 2px;
  }

  .star {
    font-size: 13px;
    color: var(--amber);
  }

  .share-avatars {
    display: flex;
  }

  .avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    color: white;
    border: 2px solid white;
    margin-left: -8px;
    flex-shrink: 0;
  }

  .avatar:first-child { margin-left: 0; }

  .avatar-more {
    background: #e0e0e0;
    color: #666;
    font-size: 10px;
  }

  /* ===== GROCERY ILLUSTRATION ===== */
  .grocery-card {
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.07);
  }

  .grocery-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 20px 24px;
    border-bottom: 1px solid #f0f0f0;
  }

  .grocery-icon-wrap { font-size: 22px; }

  .grocery-title {
    flex: 1;
    font-size: 16px;
    font-weight: 700;
    color: var(--deep-green);
  }

  .grocery-count {
    font-size: 13px;
    color: #999;
  }

  .grocery-list {
    list-style: none;
    padding: 8px 0;
  }

  .g-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 24px;
    border-bottom: 1px solid #f8f8f8;
    font-size: 15px;
  }

  .g-item:last-child { border-bottom: none; }

  .g-check {
    width: 24px;
    height: 24px;
    min-width: 24px;
    background: var(--deep-green);
    color: var(--green);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
  }

  .g-check-empty {
    width: 24px;
    height: 24px;
    min-width: 24px;
    border: 2px solid #ddd;
    border-radius: 50%;
  }

  .g-checked { opacity: 0.45; }
  .g-checked .g-name { text-decoration: line-through; }

  .g-name {
    flex: 1;
    color: var(--text-dark);
    font-weight: 500;
  }

  .g-qty {
    font-size: 13px;
    color: #999;
    font-weight: 500;
  }

  /* ===== MEAL PLAN ILLUSTRATION ===== */
  .meal-plan-card {
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(8, 65, 33, 0.18);
  }

  .mp-header {
    background: var(--deep-green);
    color: var(--green);
    padding: 16px 20px;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mp-badge {
    font-size: 12px;
    background: rgba(208, 255, 194, 0.15);
    border-radius: 100px;
    padding: 3px 10px;
  }

  .mp-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .mp-day {
    border-right: 1px solid #f0f0f0;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mp-day:last-child { border-right: none; }

  .mp-day-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #aaa;
    margin-bottom: 4px;
  }

  .mp-slot {
    background: var(--cream);
    border-radius: 8px;
    padding: 8px;
    font-size: 11px;
    line-height: 1.4;
    color: var(--text-dark);
  }

  .mp-slot-d {
    background: rgba(8, 65, 33, 0.06);
  }

  .mp-slot-empty {
    background: transparent;
    border: 1.5px dashed #ddd;
    color: #bbb;
    text-align: center;
    font-size: 11px;
  }

  /* ===== CTA ===== */
  .cta {
    background: var(--orange);
    padding: 120px 32px;
    text-align: center;
  }

  .cta-inner {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 16px;
  }

  .cta-heading {
    font-family: 'Fraunces', serif;
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 300;

    color: white;
    line-height: 1.1;
    margin-bottom: 16px;
    letter-spacing: -0.025em;
  }

  .cta-body {
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 44px;
  }

  /* ===== FOOTER ===== */
  .footer {
    background: var(--deep-green);
    padding: 56px 32px;
    border-top: 1px solid rgba(208, 255, 194, 0.08);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .footer-top {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    color: var(--green);
    text-decoration: none;
  }

  .footer-tagline {
    font-size: 15px;
    color: rgba(208, 255, 194, 0.45);
  }

  .footer-divider {
    height: 1px;
    background: rgba(208, 255, 194, 0.08);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer-copy {
    font-size: 14px;
    color: rgba(208, 255, 194, 0.35);
  }

  .footer-links {
    display: flex;
    gap: 28px;
  }

  .footer-links a {
    font-size: 14px;
    color: rgba(208, 255, 194, 0.45);
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--green);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 900px) {
    .hero-inner,
    .feature-inner,
    .feature-inner.reverse {
      flex-direction: column;
      gap: 56px;
    }

    .hero-visual { order: -1; }

    .phone-frame {
      width: 220px;
      height: 460px;
    }

    .feature-visual,
    .feature-text {
      width: 100%;
    }

    .share-card-sm { margin-left: 12px; }
  }

  @media (max-width: 600px) {
    .nav-inner { padding: 12px 20px; }
    .hero-inner,
    .feature { padding-left: 20px; padding-right: 20px; }
    .feature { padding-top: 80px; padding-bottom: 80px; }
    .hero-inner { padding: 56px 20px; }
    .mp-grid { grid-template-columns: repeat(2, 1fr); }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
    .cta { padding: 80px 20px; }
  }
</style>

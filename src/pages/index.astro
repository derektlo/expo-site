---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Expo — Share recipes with your friends & family">

  <!-- NAV -->
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="logo" aria-label="Expo">
        <img src="/expo-logo.svg" alt="Expo" width="120" height="33" class="logo-img" />
      </a>
      <a href="#download" class="nav-cta">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="15" height="15" aria-hidden="true">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        Download
      </a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <img src="/illus/sparkles.svg" class="deco-illus hero-sparkles" aria-hidden="true" alt="" />
    <div class="hero-inner">
      <div class="hero-content">
        <h1 class="hero-heading">Share recipes with friends</h1>
        <p class="hero-sub">Import recipes from anywhere, see what your friends and family are cooking, track your grocery list and more.</p>
        <a href="#" class="appstore-badge-link" id="download">
          <img src="/app-store-badge.svg" alt="Download on the App Store" class="appstore-badge-img" />
        </a>
      </div>
      <div class="hero-visual">
        <div class="phone-frame">
          <img src="/screenshots/explore.png" alt="Expo app — Explore screen showing recipe feed" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE: Import -->
  <section class="feature feat-cream" style="position:relative;overflow:hidden;">
    <img src="/illus/chili.svg" class="deco-illus" style="right:-10px;top:30px;width:130px;opacity:0.18;transform:rotate(-20deg);" aria-hidden="true" alt="" />
    <div class="feature-inner">
      <div class="feature-text">
        <div class="feat-icon" style="background: var(--orange);">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="26" height="26" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
        </div>
        <h2 class="feat-heading">Import recipes from anywhere</h2>
        <p class="feat-body">Spotted something delicious while scrolling? Paste any link and Expo extracts the full recipe instantly — ingredients, steps, and all.</p>
        <ul class="feat-list">
          <li>Any recipe website</li>
          <li>Instagram &amp; TikTok posts</li>
          <li>YouTube cooking videos</li>
          <li>Screenshots &amp; photos</li>
        </ul>
      </div>
      <div class="feature-phone">
        <div class="phone-frame phone-light">
          <img src="/screenshots/import.png" alt="Expo app — importing a recipe from a website" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE: AI -->
  <section class="feature feat-dark" style="position:relative;overflow:hidden;">
    <img src="/illus/mushroom.svg" class="deco-illus" style="left:-20px;bottom:20px;width:160px;opacity:0.12;filter:invert(1);" aria-hidden="true" alt="" />
    <div class="feature-inner reverse">
      <div class="feature-phone">
        <div class="phone-frame">
          <img src="/screenshots/create.png" alt="Expo app — AI recipe generation screen" loading="lazy" />
        </div>
      </div>
      <div class="feature-text">
        <div class="feat-icon" style="background: var(--amber);">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="var(--deep-green)" width="26" height="26" aria-hidden="true">
            <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6L12 2z"/>
          </svg>
        </div>
        <h2 class="feat-heading" style="color: var(--green);">Personalize recipes to your taste</h2>
        <p class="feat-body" style="color: rgba(208,255,194,0.7);">Make any recipe your own. Describe what you're craving, swap out what you don't have, and let AI adapt dishes to your diet, skill level, or whatever is in the fridge.</p>
        <ul class="feat-list feat-list-light">
          <li>Generate from ingredients you have</li>
          <li>Adapt to dietary restrictions</li>
          <li>Scale servings instantly</li>
          <li>Suggest smart substitutions</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FEATURE: Share -->
  <section class="feature feat-green" style="position:relative;overflow:hidden;">
    <img src="/illus/heart.svg" class="deco-illus" style="right:-20px;bottom:-10px;width:180px;opacity:0.2;transform:rotate(10deg);" aria-hidden="true" alt="" />
    <div class="feature-inner">
      <div class="feature-text">
        <div class="feat-icon" style="background: var(--deep-green);">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="26" height="26" aria-hidden="true">
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
          </svg>
        </div>
        <h2 class="feat-heading">Share recipes with your friends</h2>
        <p class="feat-body" style="color: rgba(8,65,33,0.7);">Build shared cookbooks with the people who matter most. Send a single recipe or an entire collection — cooking together has never been easier.</p>
        <ul class="feat-list" style="--check-bg: var(--deep-green); --check-text: var(--green);">
          <li>Shared family cookbooks</li>
          <li>Rate &amp; comment on recipes</li>
          <li>Activity feed from friends</li>
          <li>Leaderboards &amp; challenges</li>
        </ul>
      </div>
      <div class="feature-visual">
        <div class="share-illustration">
          <div class="share-card">
            <div class="share-emoji">🍜</div>
            <div class="share-info">
              <strong>Spicy Beef Pho</strong>
              <span>By Derek Lo</span>
              <div class="star-row">
                <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
              </div>
            </div>
            <div class="share-avatars">
              <div class="avatar" style="background:#FF582A">Z</div>
              <div class="avatar" style="background:#6D2239">M</div>
              <div class="avatar" style="background:#084121">J</div>
              <div class="avatar avatar-more">+4</div>
            </div>
          </div>
          <div class="share-card share-card-sm">
            <div class="share-emoji" style="font-size:24px;">🎂</div>
            <div class="share-info">
              <strong>Carrot Cake</strong>
              <span>By Zack Sparks</span>
              <div class="star-row">
                <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star" style="color:#ddd">★</span>
              </div>
            </div>
          </div>
          <div class="share-card share-card-sm" style="margin-left:48px;">
            <div class="share-emoji" style="font-size:24px;">🍋</div>
            <div class="share-info">
              <strong>Lemon Tart</strong>
              <span>By Maya Chen</span>
              <div class="star-row">
                <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE: Grocery -->
  <section class="feature feat-white" style="position:relative;overflow:hidden;">
    <img src="/illus/pepper.svg" class="deco-illus" style="right:-10px;bottom:20px;width:120px;opacity:0.1;transform:rotate(8deg);" aria-hidden="true" alt="" />
    <div class="feature-inner reverse">
      <div class="feature-visual">
        <div class="grocery-card">
          <div class="grocery-header">
            <span class="grocery-icon-wrap">🛒</span>
            <span class="grocery-title">Tonight's Groceries</span>
            <span class="grocery-count">6 items</span>
          </div>
          <ul class="grocery-list">
            <li class="g-item g-checked">
              <span class="g-check">✓</span>
              <span class="g-name">Heavy cream</span>
              <span class="g-qty">400 ml</span>
            </li>
            <li class="g-item g-checked">
              <span class="g-check">✓</span>
              <span class="g-name">Garlic</span>
              <span class="g-qty">6 cloves</span>
            </li>
            <li class="g-item">
              <span class="g-check-empty"></span>
              <span class="g-name">Chicken breast</span>
              <span class="g-qty">800 g</span>
            </li>
            <li class="g-item">
              <span class="g-check-empty"></span>
              <span class="g-name">Fresh thyme</span>
              <span class="g-qty">1 bunch</span>
            </li>
            <li class="g-item">
              <span class="g-check-empty"></span>
              <span class="g-name">Parmesan</span>
              <span class="g-qty">100 g</span>
            </li>
            <li class="g-item">
              <span class="g-check-empty"></span>
              <span class="g-name">Pappardelle</span>
              <span class="g-qty">250 g</span>
            </li>
          </ul>
        </div>
      </div>
      <div class="feature-text">
        <div class="feat-icon" style="background: var(--deep-green);">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="26" height="26" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
        </div>
        <h2 class="feat-heading">Create grocery lists and track ingredients</h2>
        <p class="feat-body">Turn any recipe or meal plan into a smart shopping list in one tap. Expo consolidates ingredients across recipes, so you only buy what you actually need.</p>
        <ul class="feat-list">
          <li>Auto-generate from any recipe</li>
          <li>Merge across multiple recipes</li>
          <li>Track your pantry inventory</li>
          <li>Organize by store section</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FEATURE: Meal Plans -->
  <section class="feature feat-amber" style="position:relative;overflow:hidden;">
    <img src="/illus/garlic.svg" class="deco-illus" style="left:-20px;top:20px;width:160px;opacity:0.15;transform:rotate(15deg);" aria-hidden="true" alt="" />
    <div class="feature-inner">
      <div class="feature-text">
        <div class="feat-icon" style="background: var(--deep-green);">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="26" height="26" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </div>
        <h2 class="feat-heading">Create meal plans</h2>
        <p class="feat-body" style="color: rgba(8,65,33,0.75);">Plan your entire week ahead and never wonder "what's for dinner?" again. Drag recipes onto your calendar and let Expo handle the shopping list.</p>
        <ul class="feat-list" style="--check-bg: var(--deep-green); --check-text: var(--amber);">
          <li>Weekly &amp; monthly planner</li>
          <li>Auto-generate grocery lists</li>
          <li>Nutrition at a glance</li>
          <li>Share plans with family</li>
        </ul>
      </div>
      <div class="feature-visual">
        <div class="meal-plan-card">
          <div class="mp-header">
            <span>Week of June 16</span>
            <span class="mp-badge">4 meals planned</span>
          </div>
          <div class="mp-grid">
            <div class="mp-day">
              <div class="mp-day-label">Mon</div>
              <div class="mp-slot mp-slot-b">🥣 Oatmeal</div>
              <div class="mp-slot mp-slot-d">🍝 Carbonara</div>
            </div>
            <div class="mp-day">
              <div class="mp-day-label">Tue</div>
              <div class="mp-slot mp-slot-b">🥑 Avo Toast</div>
              <div class="mp-slot mp-slot-d">🍜 Beef Pho</div>
            </div>
            <div class="mp-day">
              <div class="mp-day-label">Wed</div>
              <div class="mp-slot mp-slot-empty">+ Add</div>
              <div class="mp-slot mp-slot-d">🍛 Curry</div>
            </div>
            <div class="mp-day">
              <div class="mp-day-label">Thu</div>
              <div class="mp-slot mp-slot-b">🍳 Eggs</div>
              <div class="mp-slot mp-slot-d">🐟 Salmon</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta" style="position:relative;overflow:hidden;">
    <img src="/illus/tomato.svg"        class="deco-illus" style="left:-20px;  bottom:-20px; width:200px; opacity:0.18; filter:invert(1); transform:rotate(-15deg);" aria-hidden="true" alt="" />
    <img src="/illus/watermelon-lg.svg" class="deco-illus" style="right:-10px; top:-10px;    width:180px; opacity:0.15; filter:invert(1); transform:rotate(20deg);"  aria-hidden="true" alt="" />
    <img src="/illus/fork.svg"          class="deco-illus" style="right:18%;   bottom:-30px; width:130px; opacity:0.13; filter:invert(1); transform:rotate(-30deg);" aria-hidden="true" alt="" />
    <img src="/illus/strawberry.svg"    class="deco-illus" style="left:12%;    top:10px;     width:110px; opacity:0.14; filter:invert(1); transform:rotate(12deg);"  aria-hidden="true" alt="" />
    <div class="cta-inner">
      <p class="cta-eyebrow">Get cooking</p>
      <h2 class="cta-heading">Start cooking smarter today.</h2>
      <p class="cta-body">Join food lovers who are discovering, personalizing, and sharing recipes with Expo.</p>
      <a href="#" class="appstore-badge-link">
        <img src="/app-store-badge-white.svg" alt="Download on the App Store" class="appstore-badge-img" />
      </a>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-top">
        <a href="/" class="footer-logo" aria-label="Expo">
          <img src="/expo-logo.svg" alt="Expo" width="120" height="33" class="logo-img" />
        </a>
        <p class="footer-tagline">Share recipes with your friends &amp; family.</p>
      </div>
      <div class="footer-divider"></div>
      <div class="footer-bottom">
        <p class="footer-copy">&copy; 2026 Expo. All rights reserved.</p>
        <div class="footer-links">
          <a href="#">Privacy Policy</a>
          <a href="#">Terms of Service</a>
          <a href="#">Contact</a>
        </div>
      </div>
    </div>
  </footer>

</Layout>

<style>
  /* ===== DECORATIVE ILLUSTRATIONS ===== */
  .deco-illus {
    position: absolute;
    pointer-events: none;
    user-select: none;
  }

  .hero-sparkles {
    right: 48px;
    bottom: 80px;
    width: 120px;
    opacity: 0.25;
    filter: brightness(0) invert(1);
  }

  /* ===== NAV ===== */
  .nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    color: var(--green);
  }

  .logo-img {
    height: 30px;
    width: auto;
  }

  .footer-logo .logo-img {
    height: 28px;
  }


  /* ===== HERO ===== */
  .hero {
    background: var(--deep-green);
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    padding-top: 20px;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -200px;
    right: -200px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(208,255,194,0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 32px;
    display: flex;
    align-items: center;
    gap: 80px;
    width: 100%;
  }

  .hero-content {
    flex: 1;
    min-width: 0;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    background: rgba(208, 255, 194, 0.1);
    border: 1px solid rgba(208, 255, 194, 0.2);
    border-radius: 100px;
    color: var(--green);
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 28px;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    background: #4ade80;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.25);
  }

  .hero-heading {
    font-family: 'Fraunces', serif;
    font-size: clamp(38px, 5.5vw, 72px);
    font-weight: 400;

    line-height: 1.08;
    color: var(--green);
    margin-bottom: 24px;
    letter-spacing: -0.025em;
    max-width: 560px;
  }

  .hero-sub {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: rgba(208, 255, 194, 0.65);
    margin-bottom: 44px;
    max-width: 460px;
  }

  .hero-visual {
    flex: 0 0 auto;
    display: flex;
    justify-content: center;
  }

  /* ===== PHONE FRAME ===== */
  .phone-frame {
    width: 260px;
    height: 540px;
    background: #1c1c1e;
    border-radius: 46px;
    padding: 13px;
    box-shadow:
      0 70px 140px rgba(0, 0, 0, 0.5),
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.1);
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
  }

  .phone-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 34px;
  }

  .phone-light {
    background: #e8e8ed;
    box-shadow:
      0 70px 140px rgba(0, 0, 0, 0.2),
      inset 0 0 0 1.5px rgba(0, 0, 0, 0.1);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 20px;
    background: var(--green);
    color: var(--deep-green);
    border-radius: 100px;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s, transform 0.2s;
  }

  .nav-cta:hover {
    background: #ffffff;
    transform: translateY(-1px);
  }

  /* ===== APP STORE BADGE ===== */
  .appstore-badge-link {
    display: inline-block;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .appstore-badge-link:hover {
    transform: translateY(-2px);
    opacity: 0.85;
  }

  .appstore-badge-img {
    height: 54px;
    width: auto;
    display: block;
  }

  /* ===== FEATURES ===== */
  .feature {
    padding: 120px 32px;
    min-height: 780px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .feature-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  .feature-inner.reverse {
    flex-direction: row-reverse;
  }

  .feature-text {
    flex: 1;
    min-width: 0;
  }

  .feature-phone {
    flex: 0 0 auto;
  }

  .feature-visual {
    flex: 1;
    min-width: 0;
  }

  .feat-cream { background: var(--cream); }
  .feat-dark  { background: var(--deep-green); }
  .feat-green { background: var(--green); }
  .feat-white { background: #ffffff; }
  .feat-amber { background: var(--amber); }

  .feat-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .feat-heading {
    font-family: 'Fraunces', serif;
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 400;

    line-height: 1.12;
    color: var(--deep-green);
    margin-bottom: 16px;
    letter-spacing: -0.015em;
  }

  .feat-body {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-mid);
    margin-bottom: 28px;
  }

  .feat-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .feat-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--deep-green);
  }

  .feat-list li::before {
    content: '✓';
    width: 22px;
    height: 22px;
    min-width: 22px;
    background: var(--check-bg, var(--deep-green));
    color: var(--check-text, var(--green));
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
  }

  .feat-list-light li {
    color: rgba(208, 255, 194, 0.85);
  }

  .feat-list-light li::before {
    background: rgba(208, 255, 194, 0.2);
    color: var(--green);
  }


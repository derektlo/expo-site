---
// Site-wide support assistant: a floating launcher + chat panel. Pure vanilla
// JS island (no framework). Calls the Supabase `support-chat` edge function,
// which retrieves over the help-center content and answers with Claude.
//
// Open it programmatically from anywhere with:
//   window.dispatchEvent(new CustomEvent('open-support-chat'))
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<div id="support-chat" class="sc-root">
  <button id="sc-launcher" class="sc-launcher" aria-label="Open support chat" aria-expanded="false" aria-controls="sc-panel">
    <svg class="sc-launcher-icon sc-icon-chat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    <svg class="sc-launcher-icon sc-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <div id="sc-panel" class="sc-panel" role="dialog" aria-modal="false" aria-label="Expo support assistant" hidden>
    <header class="sc-header">
      <div class="sc-header-title">
        <span class="sc-dot" aria-hidden="true"></span>
        Expo Assistant
      </div>
      <button id="sc-close" class="sc-close" aria-label="Close support chat">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </header>

    <div id="sc-messages" class="sc-messages" aria-live="polite">
      <div class="sc-msg sc-msg-bot">
        <p>Hi! I'm Expo's assistant. Ask me anything about importing, generating, cooking, planning, or sharing recipes.</p>
      </div>
    </div>

    <form id="sc-form" class="sc-form">
      <input id="sc-input" class="sc-input" type="text" autocomplete="off"
             placeholder="Ask a question…" aria-label="Type your question" maxlength="1000" />
      <button id="sc-send" class="sc-send" type="submit" aria-label="Send">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </form>
    <p class="sc-footnote">Answers come from Expo's help center. For more, email <a href="mailto:support@heyexpo.com">support@heyexpo.com</a>.</p>
  </div>
</div>

<script define:vars={{ supabaseUrl, supabaseAnonKey }}>
  (function () {
    const root = document.getElementById('support-chat');
    if (!root) return;
    const launcher = document.getElementById('sc-launcher');
    const panel = document.getElementById('sc-panel');
    const closeBtn = document.getElementById('sc-close');
    const messages = document.getElementById('sc-messages');
    const form = document.getElementById('sc-form');
    const input = document.getElementById('sc-input');
    const sendBtn = document.getElementById('sc-send');

    const endpoint = supabaseUrl ? `${supabaseUrl}/functions/v1/support-chat` : '';
    const history = []; // { role, content }
    let busy = false;

    function setOpen(open) {
      panel.hidden = !open;
      launcher.setAttribute('aria-expanded', String(open));
      launcher.classList.toggle('sc-open', open);
      if (open) setTimeout(() => input.focus(), 50);
    }
    function isOpen() { return !panel.hidden; }

    launcher.addEventListener('click', () => setOpen(!isOpen()));
    closeBtn.addEventListener('click', () => { setOpen(false); launcher.focus(); });
    window.addEventListener('open-support-chat', () => setOpen(true));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) { setOpen(false); launcher.focus(); }
    });

    function escapeHtml(s) {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function addMessage(role, html) {
      const el = document.createElement('div');
      el.className = `sc-msg sc-msg-${role}`;
      el.innerHTML = html;
      messages.appendChild(el);
      messages.scrollTop = messages.scrollHeight;
      return el;
    }

    function renderAnswer(answer, sources) {
      const paras = escapeHtml(answer).split(/\n{2,}/).map((p) => `<p>${p.replace(/\n/g, '<br>')}</p>`).join('');
      let html = paras;
      if (sources && sources.length) {
        const links = sources
          .map((s) => `<a href="${escapeHtml(s.url)}" target="_blank" rel="noopener">${escapeHtml(s.title)}</a>`)
          .join('');
        html += `<div class="sc-sources"><span>Related help</span>${links}</div>`;
      }
      return html;
    }

    async function ask(question) {
      if (busy || !question.trim()) return;
      if (!endpoint) {
        addMessage('bot', '<p>Support chat is not configured. Please email <a href="mailto:support@heyexpo.com">support@heyexpo.com</a>.</p>');
        return;
      }
      busy = true;
      sendBtn.disabled = true;
      input.value = '';
      addMessage('user', `<p>${escapeHtml(question)}</p>`);
      const typing = addMessage('bot', '<span class="sc-typing"><span></span><span></span><span></span></span>');

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${supabaseAnonKey}`,
            'apikey': supabaseAnonKey,
          },
          body: JSON.stringify({ question, history: history.slice(-6) }),
        });
        const data = await res.json().catch(() => ({}));
        const answer = data.answer || "Sorry, something went wrong. Please try again, or email support@heyexpo.com.";
        typing.innerHTML = renderAnswer(answer, data.sources);
        history.push({ role: 'user', content: question });
        history.push({ role: 'assistant', content: answer });
      } catch (err) {
        typing.innerHTML = '<p>I couldn\'t reach the assistant. Please check your connection and try again, or email <a href="mailto:support@heyexpo.com">support@heyexpo.com</a>.</p>';
      } finally {
        busy = false;
        sendBtn.disabled = false;
        messages.scrollTop = messages.scrollHeight;
        input.focus();
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      ask(input.value);
    });
  })();
</script>

<style>
  .sc-root { position: fixed; bottom: 24px; right: 24px; z-index: 1000; }

  .sc-launcher {
    width: 60px; height: 60px; border-radius: 50%; border: none; cursor: pointer;
    background: var(--green); color: var(--deep-green);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 12px 32px rgba(8, 65, 33, 0.32);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .sc-launcher:hover { transform: translateY(-2px); }
  .sc-launcher-icon { width: 26px; height: 26px; position: absolute; transition: opacity 0.15s ease, transform 0.15s ease; }
  .sc-icon-close { opacity: 0; transform: rotate(-45deg); }
  .sc-launcher.sc-open .sc-icon-chat { opacity: 0; transform: rotate(45deg); }
  .sc-launcher.sc-open .sc-icon-close { opacity: 1; transform: rotate(0); }

  .sc-panel {
    position: absolute; bottom: 76px; right: 0;
    width: min(380px, calc(100vw - 32px)); height: min(560px, calc(100vh - 120px));
    background: #fff; border-radius: 20px; overflow: hidden;
    display: flex; flex-direction: column;
    box-shadow: 0 24px 64px rgba(8, 65, 33, 0.28);
    border: 1px solid rgba(8, 65, 33, 0.08);
  }

  .sc-header {
    background: var(--deep-green); color: var(--green);
    padding: 16px 18px; display: flex; align-items: center; justify-content: space-between;
  }
  .sc-header-title { display: flex; align-items: center; gap: 9px; font-weight: 600; font-size: 15px; }
  .sc-dot { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0 3px rgba(74,222,128,0.25); }
  .sc-close { background: transparent; border: none; color: var(--green); cursor: pointer; padding: 4px; opacity: 0.8; }
  .sc-close:hover { opacity: 1; }
  .sc-close svg { width: 20px; height: 20px; }

  .sc-messages { flex: 1; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 12px; background: var(--cream); }

  .sc-msg { max-width: 88%; font-size: 14.5px; line-height: 1.55; border-radius: 16px; padding: 11px 14px; }
  .sc-msg p { margin: 0 0 8px; }
  .sc-msg p:last-child { margin-bottom: 0; }
  .sc-msg-bot { background: #fff; color: var(--text-dark); align-self: flex-start; border-bottom-left-radius: 5px; box-shadow: 0 2px 10px rgba(8,65,33,0.06); }
  .sc-msg-user { background: var(--deep-green); color: var(--green); align-self: flex-end; border-bottom-right-radius: 5px; }
  .sc-msg a { color: var(--orange); text-decoration: underline; }

  .sc-sources { margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(8,65,33,0.1); display: flex; flex-direction: column; gap: 5px; }
  .sc-sources span { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #999; }
  .sc-sources a { font-size: 13px; color: var(--deep-green); text-decoration: none; font-weight: 500; }
  .sc-sources a:hover { text-decoration: underline; }

  .sc-typing { display: inline-flex; gap: 4px; padding: 2px 0; }
  .sc-typing span { width: 7px; height: 7px; border-radius: 50%; background: #bbb; animation: sc-bounce 1.2s infinite ease-in-out; }
  .sc-typing span:nth-child(2) { animation-delay: 0.15s; }
  .sc-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes sc-bounce { 0%, 60%, 100% { transform: translateY(0); opacity: 0.5; } 30% { transform: translateY(-5px); opacity: 1; } }

  .sc-form { display: flex; gap: 8px; padding: 12px; border-top: 1px solid rgba(8,65,33,0.08); background: #fff; }
  .sc-input { flex: 1; border: 1px solid rgba(8,65,33,0.15); border-radius: 100px; padding: 11px 16px; font-size: 14.5px; font-family: inherit; outline: none; }
  .sc-input:focus { border-color: var(--deep-green); }
  .sc-send { width: 42px; height: 42px; min-width: 42px; border: none; border-radius: 50%; background: var(--deep-green); color: var(--green); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .sc-send:hover { background: #0a5329; }
  .sc-send:disabled { opacity: 0.5; cursor: default; }
  .sc-send svg { width: 18px; height: 18px; }

  .sc-footnote { font-size: 11px; color: #999; text-align: center; padding: 0 12px 12px; background: #fff; margin: 0; }
  .sc-footnote a { color: #999; text-decoration: underline; }

  @media (max-width: 600px) {
    .sc-root { bottom: 16px; right: 16px; }
    .sc-panel { bottom: 72px; }
  }
</style>
